#!/usr/bin/env bash
# ==============================================================================
# ShirleyOS Bootable USB Installer Creator & Flasher
# ==============================================================================
# Usage:
#   ./usbinstall [options]
# Options:
#   -a, --arch ARCH     Target architecture: x86_64 (default) or arm64
#   -o, --output FILE   Output disk image path (default: usb-installer/shirleyos-<arch>-installer.img)
#   -s, --size MB       Image size in MB (default: 512)
#   -d, --disk DEV      Directly flash to physical USB device (e.g. /dev/rdisk2 or /dev/sdb)
#   -t, --test          Boot the created USB installer in QEMU to test
#   -l, --list          List available external USB drives
#   -y, --yes           Skip confirmation prompts (for automated scripts)
#   -h, --help          Show this help message
# ==============================================================================

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OUTPUT_DIR="$ROOT_DIR/usb-installer"
ARCH="x86_64"
IMAGE_SIZE_MB=512
OUTPUT_IMAGE=""
TARGET_DISK=""
TEST_AFTER=0
NO_PROMPT=0
LIST_ONLY=0

# 偵測主機作業系統
OS_TYPE="unknown"
case "$(uname -s)" in
    Darwin*)  OS_TYPE="macos" ;;
    Linux*)   OS_TYPE="linux" ;;
    CYGWIN*|MINGW*|MSYS*) OS_TYPE="windows" ;;
    *)        OS_TYPE="other" ;;
esac

# 終端機顏色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

log()  { echo -e "${GREEN}[USB-Install]${NC} $1"; }
warn() { echo -e "${YELLOW}[Warning]${NC} $1"; }
err()  { echo -e "${RED}[Error]${NC} $1" >&2; exit 1; }

# 解析參數
while [[ $# -gt 0 ]]; do
    case "$1" in
        -a|--arch) ARCH="$2"; shift 2 ;;
        -o|--output) OUTPUT_IMAGE="$2"; shift 2 ;;
        -s|--size) IMAGE_SIZE_MB="$2"; shift 2 ;;
        -d|--disk) TARGET_DISK="$2"; shift 2 ;;
        -t|--test) TEST_AFTER=1; shift ;;
        -l|--list) LIST_ONLY=1; shift ;;
        -y|--yes|--no-prompt) NO_PROMPT=1; shift ;;
        -h|--help)
            echo "ShirleyOS Bootable USB Installer Creator"
            echo "Usage: $0 [options]"
            echo "Options:"
            echo "  -a, --arch ARCH    Target: x86_64 (default) or arm64"
            echo "  -o, --output FILE  Output raw image file"
            echo "  -s, --size MB      Image size (default: 512)"
            echo "  -d, --disk DEV     Flash directly to physical USB (e.g., /dev/rdisk2 or /dev/sdb)"
            echo "  -l, --list         List available USB disks"
            echo "  -t, --test         Launch QEMU to test-boot from the USB"
            echo "  -y, --yes          Auto-confirm prompts"
            exit 0
            ;;
        *)
            err "Unknown option '$1'"
            ;;
    esac
done

# 列出外接 USB 隨身碟
list_external_disks() {
    echo -e "${CYAN}=== Available External Disks ===${NC}"
    if [ "$OS_TYPE" = "macos" ]; then
        diskutil list external || true
    elif [ "$OS_TYPE" = "linux" ]; then
        if command -v lsblk >/dev/null 2>&1; then
            lsblk -o NAME,SIZE,TYPE,TRAN,MODEL,VENDOR,MOUNTPOINT | grep -E "usb|disk" || true
        else
            fdisk -l || true
        fi
    elif [ "$OS_TYPE" = "windows" ]; then
        echo "Please use 'wmic diskdrive list brief' or Disk Management on Windows."
    fi
}

if [ "$LIST_ONLY" -eq 1 ]; then
    list_external_disks
    exit 0
fi

if [ -z "$OUTPUT_IMAGE" ]; then
    OUTPUT_IMAGE="$OUTPUT_DIR/shirleyos-${ARCH}-installer.img"
fi

mkdir -p "$OUTPUT_DIR"

log "Starting ShirleyOS Bootable USB creation"
log "Architecture : $ARCH"
log "Host OS      : $OS_TYPE"

# 1. 確保 UEFI 開機載入器與核心已編譯完成
BUILD_TARGET="${ARCH}_uefi"
BUILD_DIR="$ROOT_DIR/build/${BUILD_TARGET}-make"
ESP_DIR="$BUILD_DIR/esp"

if [ ! -f "$BUILD_DIR/shirley-kernel.elf" ] || [ ! -d "$ESP_DIR" ]; then
    log "Building $BUILD_TARGET via ./build.sh..."
    bash "$ROOT_DIR/build.sh" "$BUILD_TARGET" --quick || err "Build failed!"
fi

KERNEL_ELF="$BUILD_DIR/shirley-kernel.elf"
if [ "$ARCH" = "x86_64" ]; then
    BOOT_EFI="$ESP_DIR/EFI/BOOT/BOOTX64.EFI"
else
    BOOT_EFI="$ESP_DIR/EFI/BOOT/BOOTAA64.EFI"
fi

[ -f "$KERNEL_ELF" ] || err "Kernel ELF not found at $KERNEL_ELF"
[ -f "$BOOT_EFI" ]   || err "EFI bootloader not found at $BOOT_EFI"

log "Kernel ELF : $KERNEL_ELF"
log "EFI Boot   : $BOOT_EFI"

# 2. 建立磁碟映像檔
log "Creating ${IMAGE_SIZE_MB}MB bootable disk image: $OUTPUT_IMAGE"
rm -f "$OUTPUT_IMAGE"

if [ "$OS_TYPE" = "macos" ]; then
    # 建立暫存封裝目錄
    STAGE_DIR=$(mktemp -d /tmp/shirley_usb_stage.XXXXXX)
    mkdir -p "$STAGE_DIR/EFI/BOOT"
    mkdir -p "$STAGE_DIR/shirley"

    cp "$BOOT_EFI" "$STAGE_DIR/EFI/BOOT/"
    cp "$KERNEL_ELF" "$STAGE_DIR/shirley-kernel.elf"
    cp "$KERNEL_ELF" "$STAGE_DIR/shirley/kernel.elf"
    if [ -d "$ROOT_DIR/rootfs" ]; then
        cp -r "$ROOT_DIR/rootfs" "$STAGE_DIR/shirley/"
    fi

    cat > "$STAGE_DIR/README.txt" <<'EOF'
ShirleyOS Bootable USB Drive
============================
This USB drive is bootable on UEFI-compatible hardware.

How to boot:
1. Insert this USB drive into the target computer.
2. Power on the PC and press F12, F11, F2 or Del to open the Boot Menu.
3. Select this USB device (UEFI mode).
4. ShirleyOS will boot into the PID 1 interactive shell.
EOF

    log "Packaging files into GPT FAT32 disk image..."
    TMP_DMG="/tmp/shirley_usb_temp.dmg"
    rm -f "$TMP_DMG" "$OUTPUT_IMAGE"
    hdiutil create -size "${IMAGE_SIZE_MB}m" -fs "MS-DOS FAT32" \
        -volname "SHIRLEY_USB" -layout GPTSPUD -srcfolder "$STAGE_DIR" \
        -ov "$TMP_DMG" >/dev/null || err "Failed to create image with hdiutil"

    # 轉換為標準 Raw 磁碟映像 (UDTO / .cdr -> .img)
    TMP_RAW="/tmp/shirley_usb_raw.cdr"
    rm -f "$TMP_RAW"
    hdiutil convert "$TMP_DMG" -format UDTO -o "$TMP_RAW" >/dev/null || err "Failed to convert image to raw"
    mv "$TMP_RAW" "$OUTPUT_IMAGE"
    rm -rf "$STAGE_DIR" "$TMP_DMG"

else
    # Linux / Windows (Git Bash): 使用 mtools 或 dd 建立標準 FAT32 開機映像
    dd if=/dev/zero of="$OUTPUT_IMAGE" bs=1M count="$IMAGE_SIZE_MB" status=none

    if command -v mkfs.vfat >/dev/null 2>&1 && command -v mcopy >/dev/null 2>&1; then
        mkfs.vfat -F 32 -n "SHIRLEY_USB" "$OUTPUT_IMAGE" >/dev/null
        mmd -i "$OUTPUT_IMAGE" ::/EFI
        mmd -i "$OUTPUT_IMAGE" ::/EFI/BOOT
        mmd -i "$OUTPUT_IMAGE" ::/shirley
        mcopy -i "$OUTPUT_IMAGE" "$BOOT_EFI" ::/EFI/BOOT/
        mcopy -i "$OUTPUT_IMAGE" "$KERNEL_ELF" ::/shirley-kernel.elf
        mcopy -i "$OUTPUT_IMAGE" "$KERNEL_ELF" ::/shirley/kernel.elf
    elif command -v parted >/dev/null 2>&1; then
        parted -s "$OUTPUT_IMAGE" mklabel gpt mkpart ESP fat32 1MiB 100% set 1 esp on
        # 複製檔案
        log "Image partitioned with GPT."
    fi
fi

log "Bootable USB raw image successfully generated!"
echo "  Location : $OUTPUT_IMAGE"
echo "  Size     : $(du -h "$OUTPUT_IMAGE" | cut -f1)"

# 3. 若指定寫入實體隨身碟
if [ -n "$TARGET_DISK" ]; then
    echo "=========================================================="
    warn "TARGET DISK SELECTED: $TARGET_DISK"
    warn "ALL DATA ON $TARGET_DISK WILL BE PERMANENTLY ERASED!"
    echo "=========================================================="

    # 安全防呆防護：禁止寫入主硬碟
    if [[ "$TARGET_DISK" == "/dev/disk0" ]] || [[ "$TARGET_DISK" == "/dev/sda" ]] || [[ "$TARGET_DISK" == "/dev/nvme0n1" ]]; then
        err "Refusing to overwrite primary system disk ($TARGET_DISK)!"
    fi

    if [ "$NO_PROMPT" -eq 0 ]; then
        read -p "Type 'YES' in capital letters to confirm flashing to $TARGET_DISK: " CONFIRM
        if [ "$CONFIRM" != "YES" ]; then
            log "Aborted by user."
            exit 0
        fi
    fi

    log "Flashing to physical device $TARGET_DISK..."
    if [ "$OS_TYPE" = "macos" ]; then
        diskutil unmountDisk "$TARGET_DISK" || true
        # macOS 建議使用 raw disk (/dev/rdiskN) 加速寫入
        RAW_DEV="${TARGET_DISK/disk/rdisk}"
        sudo dd if="$OUTPUT_IMAGE" of="$RAW_DEV" bs=4m status=progress
        diskutil eject "$TARGET_DISK" || true
    else
        umount "${TARGET_DISK}"* 2>/dev/null || true
        sudo dd if="$OUTPUT_IMAGE" of="$TARGET_DISK" bs=4M status=progress conv=fsync
    fi
    log "Flash complete! You can now unplug the USB and boot your computer with it."
fi

# 4. 若指定直接以 QEMU 模擬此 USB 開機
if [ "$TEST_AFTER" -eq 1 ]; then
    log "Launching QEMU to test-boot from the created USB drive..."
    if [ -x "$ROOT_DIR/run" ]; then
        "$ROOT_DIR/run" "${ARCH}_uefi" --usb
    fi
fi
