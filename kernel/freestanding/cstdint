#pragma once
// 裸機核心使用的 <cstdint> 最小子集，只涵蓋實際用到的無號整數型別。
// The minimal subset of <cstdint> the freestanding kernel uses: only the
// unsigned integer types it actually needs.
namespace std {
using uint8_t=unsigned char; using uint16_t=unsigned short; using uint32_t=unsigned int;
using uint64_t=unsigned long long; using uintptr_t=unsigned long long;
}
