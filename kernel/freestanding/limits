#pragma once
// 裸機核心使用的 std::numeric_limits 最小子集，只支援無號整數型別。
// The minimal subset of std::numeric_limits the freestanding kernel uses;
// unsigned integer types only.
namespace std {
template <class T> struct numeric_limits {
    static constexpr T max() { return static_cast<T>(~static_cast<T>(0)); }
    static constexpr T min() { return static_cast<T>(0); }
    static constexpr bool is_signed = false;
};
}
