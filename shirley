#!/usr/bin/env sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
host=$(uname -m)
command=${1:-run}
target=${2:-$host}
case "$command" in
  arm64|x86_64) target=$command; command=run ;;
  build|run|debug) ;;
  test) exec "$root/scripts/test-all.sh" ;;
  *) echo "Usage: ./shirley [arm64|x86_64|build|run|debug|test] [arm64|x86_64]" >&2; exit 2 ;;
esac
case "$target" in
  arm64|aarch64) target=arm64 ;;
  x86_64|amd64) target=x86_64 ;;
  *) echo "Unsupported target: $target" >&2; exit 2 ;;
esac
echo "ShirleyOS Development Runner"
echo "Host: macOS $host"
echo "Target: ShirleyOS $target"
case "$command" in
  build) exec "$root/scripts/build-$target.sh" ;;
  run) exec "$root/scripts/run-$target.sh" ;;
  debug) exec "$root/scripts/debug-$target.sh" ;;
esac
